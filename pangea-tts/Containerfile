FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        espeak-ng curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/app-root/src

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

ARG KOKORO_VOICES_URL=https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin
RUN curl -fL "$KOKORO_VOICES_URL" -o /opt/app-root/src/voices.bin

COPY config.py kokoro_remote.py app.py ./

RUN chmod -R g+rwX /opt/app-root/src /tmp

ENV HOME=/tmp \
    VOICES_PATH=/opt/app-root/src/voices.bin \
    PYTHONUNBUFFERED=1

USER 1001
EXPOSE 8080
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080"]
